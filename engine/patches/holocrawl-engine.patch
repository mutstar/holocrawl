+            }
+        }
+        for(auto &p:s.targets) if(at>=p.second.expires) p.second.stacks=0;
+    }
+}
+void resource_after_attack(monster *target,int)
+{
+    const int now=you.elapsed_time;
+    if(is(god_id::suisei) && ctx.damaged && target && target->alive()) {
+        if(s.marked==MID_NOBODY || s.one_end<=now) { s.resource=0;s.marked=ctx.target; }
+        if(s.marked==ctx.target) { s.resource=min(5,s.resource+1);s.one_end=now+100; }
+    }
+    if(is(god_id::choco) && ctx.damaged && s.secondary>=0 && target && target->alive()
+        && target->mid==s.marked && s.one_end>now) {
+        s.resource=min(5,s.resource+1);s.one_end=now+100+3*s.inv;
+        auto &t=s.targets[s.marked];
+        if(s.resource==5 && t.next<=now && !mental_immune(*target)) { root(*target,10);t.root=now+10;t.next=now+80; }
+    }
+    if(is(god_id::korone)) {
+        if(ctx.eligible && ctx.damaged && ctx.kind==attack_kind::melee && now>=s.offence && !five()) {
+            s.resource=min(6,s.resource+1);s.one_end=now+50;
+        }
+        if(five() && ctx.kind==attack_kind::melee && target && target->alive() && roll_hit(*target,20+s.inv))
+            hurt(*target,roll_dice(1,6+s.inv/2));
+    }
+    if(is(god_id::lamy) && ctx.damaged && target && target->alive() && (s.resource>=20 || five())) {
+        int raw=roll_dice(1,3+s.inv/6);if(!five() && s.resource>=61) raw=div_rand_round(raw*115,100);
+        if(hurt(*target,raw,BEAM_COLD,false)>0 && target->alive()) chill(*target,1,now);
+    }
+}
+void resource_move(const coord_def &,bool) {}
+void resource_kill(mid_t mid,int,bool direct,bool ordinary)
+{
+    if(is(god_id::suisei) && direct && ordinary && ctx.stars_before>0) {
+        s.offence=roll_dice(1,5+2*ctx.stars_before);s.three_end=you.elapsed_time+30;
+    }
+    if(is(god_id::suisei) && s.marked==mid) { s.marked=MID_NOBODY;s.resource=0; }
+    if(is(god_id::okayu) && direct) s.resource=min(100,s.resource+3);
+    if(is(god_id::choco) && s.secondary<0 && s.marked==mid) charm_end(you.elapsed_time);
+}
+int resource_incoming(int damage,kill_method_type kind,mid_t source)
+{
+    const int now=you.elapsed_time;const monster *mon=monster_by_mid(source);
+    const bool hostile=mon && eligible(*mon) && (kind==KILLED_BY_MONSTER || kind==KILLED_BY_BEAM);
+    if(is(god_id::choco) && hostile && s.targets[source].weak_until>now) damage=div_rand_round(damage*80,100);
+    if(is(god_id::korone)) {
+        if(hostile && damage>=max(1,(you.hp_max*3+99)/100) && now>=s.proc_ready && now>=s.offence && !five()) {
+            s.resource=min(6,s.resource+1);s.one_end=now+50;s.proc_ready=now+10;
+        }
+        if(five() && source!=you.mid && (kind==KILLED_BY_MONSTER || kind==KILLED_BY_BEAM)) {
+            const int deferred=damage/4;s.deferred+=deferred;damage-=deferred;
+        }
+    }
+    if(is(god_id::okayu) && hostile) {
+        s.last_event=now+50;const int absorbed=min(s.shield,damage);
+        s.shield-=absorbed;damage-=absorbed;s.totals.absorbed+=absorbed;
+    }
+    return damage;
+}
+void companion_damage(const actor *attacker,int damage)
+{
+    if(!is(god_id::choco) || s.secondary>=0 || !attacker || attacker->mid!=s.marked || damage<=0) return;
+    const int bucket=you.elapsed_time/10;
+    if(s.last_event!=bucket) { s.last_event=bucket;s.tertiary=0; }
+    s.regen_fraction+=15*damage;const int wanted=min(3-s.tertiary,s.regen_fraction/100);
+    s.regen_fraction%=100;s.tertiary+=wanted;heal(wanted);
+}
+void resource_contact(const actor *attacker,beam_type)
+{
+    if(is(god_id::okayu) && attacker && attacker->is_monster()) {
+        const monster *mon=monster_by_mid(attacker->mid);
+        if(mon && eligible(*mon)) s.last_event=you.elapsed_time+50;
+    }
+}
+}
diff --git a/crawl-ref/source/holo-batch-space.cc b/crawl-ref/source/holo-batch-space.cc
new file mode 100644
index 0000000000000000000000000000000000000000..16d1651a169934007f71d0cec57858348adc63e9
--- /dev/null
+++ b/crawl-ref/source/holo-batch-space.cc
@@ -0,0 +1,210 @@
+#include "AppHdr.h"
+#include "holo-batch-internal.h"
+#include <algorithm>
+#include "act-iter.h"
+#include "env.h"
+#include "fight.h"
+#include "holocrawl.h"
+#include "mon-util.h"
+#include "player.h"
+#include "terrain.h"
+namespace holo_batch {
+namespace {
+bool water(const coord_def &pos,int at) {
+    if(grd(pos)!=DNGN_FLOOR || !seen(pos)) return false;
+    if(s.five_end>at && grid_distance(you.pos(),pos)<=2) return true;
+    for(const auto &h:s.hazards) if(h.kind==20 && h.pos==pos && h.end>at) return true;
+    return false;
+}
+void explosion(const coord_def &origin,int dice,int at,const coord_def *limit=nullptr) {
+    const int raw=roll_dice(dice,8+s.inv/3),fire=raw/2,fragment=raw-fire;
+    std::vector<mid_t> victims;
+    for(monster_iterator mi;mi;++mi) if(mi->alive() && grid_distance(origin,mi->pos())<=1
+        && (!limit || grid_distance(*limit,mi->pos())<=3) && line(origin,mi->pos())) victims.push_back(mi->mid);
+    for(mid_t id:victims) {
+        monster *mon=monster_by_mid(id);if(!mon || !mon->alive()) continue;
+        hurt(*mon,fire,BEAM_FIRE,false,true);if(mon->alive()) hurt(*mon,fragment);
+    }
+    if(grid_distance(origin,you.pos())<=1 && (!limit || grid_distance(*limit,you.pos())<=3) && line(origin,you.pos())) {
+        int damage=resist_adjust_damage(&you,BEAM_FIRE,fire)+you.apply_ac(fragment);
+        if(you.piety>=75 && damage>0) damage=max(1,div_rand_round(damage*75,100));
+        const int before=you.hp;ouch(damage,KILLED_BY_WILD_MAGIC,you.mid,"carrot explosion");
+        s.totals.self_damage+=max(0,before-you.hp);
+    }
+    // Mark for this same logical instant; the caller drains chains without re-entering this vector.
+    for(auto &h:s.hazards) if(h.kind==10 && h.end>at && grid_distance(origin,h.pos)<=1 && line(origin,h.pos)) h.next=at;
+}
+void drain_bombs(int at) {
+    bool again=true;
+    while(again && !holo_benchmark_finished()) {
+        again=false;
+        for(size_t i=0;i<s.hazards.size();++i) {
+            auto &h=s.hazards[i];if(h.kind!=10 || h.end<=at) continue;
+            const monster *mon=monster_at(h.pos);
+            if(h.next>at && !(h.extra==0 && h.arm<=at && mon && mon->attitude==ATT_HOSTILE && !mon->airborne())) continue;
+            const coord_def origin=h.pos;h.end=0;h.next=0;
+            explosion(origin,2,at);again=true;
+        }
+    }
+}
+bool qualifies(const monster &mon) {
+    return mon.alive() && mon.attitude==ATT_HOSTILE && you.can_see(mon)
+        && s.one_end>you.elapsed_time && grid_distance(s.centre,mon.pos())<=2 && line(s.centre,mon.pos());
+}
+}
+int space_action(monster *target)
+{
+    if(!target || !target->alive()) return 0;
+    const int now=you.elapsed_time;
+    if(is(god_id::su)) {
+        if(!five() && now>=s.five_ready && pay(6,12,120)) {
+            s.five_end=now+10+60+2*s.inv;s.five_ready=s.five_end+150;s.last_event=now+20;return 10;
+        }
+        if(now>=s.three_ready && grid_distance(you.pos(),target->pos())<=5) {
+            coord_def d=target->pos()-you.pos();d.x=(d.x>0)-(d.x<0);d.y=(d.y>0)-(d.y<0);
+            bool wide=five();std::set<coord_def> cells;
+            for(int r=1;r<=5;++r) {
+                const coord_def p=you.pos()+d*r;if(!in_bounds(p) || feat_is_solid(grd(p)) || !line(you.pos(),p)) break;
+                wide|=water(p,now);
+                cells.insert(p);
+                if(wide) for(int side:{-1,1}) {
+                    const coord_def q=p+coord_def(-d.y*side,d.x*side);
+                    if(in_bounds(q) && seen(q)) cells.insert(q);
+                }
+            }
+            std::vector<mid_t> victims;
+            for(mid_t id:enemies(you.pos(),6,true)) if(cells.count(monster_by_mid(id)->pos())) victims.push_back(id);
+            if(!victims.empty() && pay(3,3,75)) {
+                for(mid_t id:victims) {
+                    monster *mon=monster_by_mid(id);hurt(*mon,roll_dice(2,7+s.inv/3)+(five()?3+s.inv/3:0),BEAM_MISSILE,true,true);
+                    if(mon->alive()) for(int step=0;step<(five()?2:1);++step) if(!move_actor(*mon,mon->pos()+d)) break;
+                }
+                s.three_ready=now+40;return 10;
+            }
+        }
+    }
+    if(is(god_id::towa)) {
+        coord_def aim=target->pos();
+        while(grid_distance(you.pos(),aim)>5) {
+            const coord_def delta=aim-you.pos();aim-=coord_def((delta.x>0)-(delta.x<0),(delta.y>0)-(delta.y<0));
+        }
+        if(s.one_end<=now && grid_distance(aim,target->pos())<=2 && seen(aim) && pay(4,4,75)) {
+            s.centre=aim;s.one_end=now+10+60+2*s.inv;s.resource=4;s.five_end=0;return 10;
+        }
+        if(s.one_end>now && seen(s.centre) && grid_distance(you.pos(),s.centre)<=6
+            && !five() && now>=s.five_ready && pay(6,12,120)) {
+            s.five_end=now+5+50+2*s.inv;s.one_end=s.five_end;s.five_ready=s.five_end+100;s.resource=8;return 5;
+        }
+    }
+    if(is(god_id::pekora)) {
+        if(now>=s.five_ready && grid_distance(you.pos(),target->pos())<=5 && pay(7,14,120)) {
+            s.centre=target->pos();int index=0;
+            for(int dx=-1;dx<=1 && index<3;++dx) {
+                const coord_def p=target->pos()+coord_def(dx,0);
+                if(!in_bounds(p) || grd(p)!=DNGN_FLOOR || !seen(p)) continue;
+                hazard h;h.pos=p;h.kind=11;h.arm=now+30+10*index++;h.end=h.arm+1;s.hazards.push_back(h);
+            }
+            s.five_ready=now+50+150;return 10;
+        }
+        int count=0;bool armed=false;
+        for(const auto &h:s.hazards) if(h.kind==10 && h.end>now) {
+            ++count;
+            if(h.arm<=now && seen(h.pos) && grid_distance(h.pos,target->pos())<=1) armed=true;
+        }
+        if(armed && pay(2,2,75)) {
+            for(auto &h:s.hazards) if(h.kind==10 && h.end>now && h.arm<=now && seen(h.pos)) h.next=now;
+            drain_bombs(now);return 5;
+        }
+        if(count<(you.piety>=75?5:3)) {
+            // Fixed policy plants in a visible empty cell next to the current enemy.
+            for(int dx=-1;dx<=1;++dx) for(int dy=-1;dy<=1;++dy) {
+                const coord_def p=target->pos()+coord_def(dx,dy);
+                if(!in_bounds(p) || actor_at(p) || grd(p)!=DNGN_FLOOR || !seen(p)
+                    || grid_distance(you.pos(),p)>(you.piety>=75?5:3)) continue;
+                bool occupied=false;for(const auto &h:s.hazards) if(h.kind==10 && h.end>now && h.pos==p) occupied=true;
+                if(!occupied && pay(2,1)) {
+                    hazard h;h.pos=p;h.kind=10;h.arm=now+20;h.end=h.arm+200;h.next=h.end+1;s.hazards.push_back(h);return 10;
+                }
+            }
+        }
+    }
+    return 0;
+}
+void space_tick(int at)
+{
+    if(is(god_id::su) && s.five_end>at && s.last_event<=at) {
+        s.last_event+=10;
+        for(mid_t id:enemies(you.pos(),2)) {
+            monster *mon=monster_by_mid(id);if(water(mon->pos(),at)) hurt(*mon,roll_dice(2,3+s.inv/6));
+        }
+    }
+    if(is(god_id::pekora)) {
+        // Expiry wins ties; delayed bombs and chains may explode without player LOS.
+        for(size_t i=0;i<s.hazards.size();++i) {
+            auto &h=s.hazards[i];if(h.kind==11 && h.arm && h.arm<=at) {
+                const coord_def pos=h.pos;h.arm=0;explosion(pos,3,at,&s.centre);
+            }
+        }
+        drain_bombs(at);
+    }
+    if(is(god_id::towa)) {
+        if(at>=s.one_end) { s.candidates.clear();return; }
+        const int bucket=at/10;
+        if(s.last_event!=bucket) { s.last_event=bucket;s.secondary=0;s.performance_hits.clear(); }
+        for(mid_t id:enemies(you.pos(),LOS_DEFAULT_RANGE)) {
+            if(!s.candidates.count(id) || s.performance_hits.count(id) || s.resource<=0
+                || s.secondary>=(s.five_end>at?2:1)) continue;
+            monster *mon=monster_by_mid(id);if(!qualifies(*mon)) continue;
+            --s.resource;++s.secondary;s.performance_hits.insert(id);
+            if(roll_hit(*mon,22+s.inv)) {
+                hurt(*mon,roll_dice(2,5+s.inv/3));
+                if(mon->alive()) s.targets[id].slowed_until=at+20;
+            }
+        }
+        s.candidates.clear();
+    }
+}
+void space_after_attack(monster *,int)
+{
+    if(!is(god_id::su) || !ctx.damaged || grd(ctx.position)!=DNGN_FLOOR) return;
+    s.hazards.erase(std::remove_if(s.hazards.begin(),s.hazards.end(),[](const hazard &h){return h.pos==ctx.position || h.end<=you.elapsed_time;}),s.hazards.end());
+    if(s.hazards.size()>=12) s.hazards.erase(s.hazards.begin());
+    hazard h;h.pos=ctx.position;h.kind=20;h.end=you.elapsed_time+50+s.inv;s.hazards.push_back(h);
+}
+void space_move(const coord_def &,bool) {}
+void space_monster(monster &mon,const coord_def &old)
+{
+    garden_entry(mon,old);
+    if(is(god_id::pekora) && old!=mon.pos()) drain_bombs(you.elapsed_time);
+    if(is(god_id::towa) && old!=mon.pos() && qualifies(mon)) s.candidates.insert(mon.mid);
+    if(is(god_id::towa) && old!=mon.pos()) s.targets[mon.mid].slowed_until=0;
+    if(is(god_id::ayame) && five() && mon.mid!=s.marked && mon.attitude==ATT_HOSTILE
+        && adjacent(old,mon.pos()) && grid_distance(s.centre,old)>2
+        && grid_distance(s.centre,mon.pos())<=2 && s.targets[mon.mid].next<=you.elapsed_time) {
+        mon.speed_increment-=(20*mon.speed+9)/10;s.targets[mon.mid].next=you.elapsed_time+30;
+    }
+    if(is(god_id::miko) && s.one_end>you.elapsed_time && s.three_end>you.elapsed_time) {
+        const int radius=five()?3:you.piety>=75?2:1;
+        if(grid_distance(s.centre,mon.pos())==radius && grid_distance(s.centre,old)!=radius
+            && s.targets[mon.mid].next<=you.elapsed_time) {
+            hurt(mon,roll_dice(1,5+s.inv/4),BEAM_FIRE,false);s.targets[mon.mid].next=you.elapsed_time+10;
+        }
+    }
+}
+void space_attempt(const actor *attacker,const actor *defender)
+{
+    if(!active() || !attacker || !defender || !defender->is_player() || !attacker->is_monster()) return;
+    if(is(god_id::okayu)) s.last_event=you.elapsed_time+50;
+    if(is(god_id::towa) && qualifies(*attacker->as_monster())) s.candidates.insert(attacker->mid);
+}
+int space_energy(const monster &mon,energy_use_type kind,int base)
+{
+    if(kind!=EUT_MOVE && kind!=EUT_SWIM) return base;
+    int percent=100;
+    if(is(god_id::su) && !mon.airborne() && mons_habitat(mon,true)!=HT_AMPHIBIOUS
+        && mons_habitat(mon,true)!=HT_WATER && mon.res_constrict()<3 && water(mon.pos(),you.elapsed_time)) percent=125;
+    if(is(god_id::towa) && s.targets[mon.mid].slowed_until>you.elapsed_time) percent=150;
+    if(mon.has_ench(ENCH_SLOW)) return base;
+    return (base*percent+99)/100;
+}
+}
diff --git a/crawl-ref/source/holo-batch-summons.cc b/crawl-ref/source/holo-batch-summons.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1a0071235298ee5430e59b9b7773782e8d13b187
--- /dev/null
+++ b/crawl-ref/source/holo-batch-summons.cc
@@ -0,0 +1,367 @@
+#include "AppHdr.h"
+#include "holo-batch-internal.h"
+#include <algorithm>
+#include <stdexcept>
+#include "act-iter.h"
+#include "beam.h"
+#include "env.h"
+#include "fight.h"
+#include "holocrawl.h"
+#include "mgen-data.h"
+#include "mon-death.h"
+#include "mon-ench.h"
+#include "mon-place.h"
+#include "mon-util.h"
+#include "player.h"
+#include "terrain.h"
+namespace holo_batch {
+namespace {
+companion *find(mid_t id) {
+    if(!active()) return nullptr;
+    for(auto &c:s.companions) if(c.mid==id) return &c;
+    return nullptr;
+}
+void dismiss(companion &c) {
+    monster *mon=monster_by_mid(c.mid);c.expires=0;
+    if(mon && mon->alive()) monster_die(*mon,KILL_DISMISSED,NON_MONSTER,true);
+}
+std::vector<coord_def> empty_cells(const coord_def &origin,int radius) {
+    std::vector<coord_def> cells;
+    for(int r=1;r<=radius;++r) for(int dx=-r;dx<=r;++dx) for(int dy=-r;dy<=r;++dy) {
+        const coord_def p=origin+coord_def(dx,dy);
+        if(max(abs(dx),abs(dy))==r && in_bounds(p) && !actor_at(p) && grd(p)==DNGN_FLOOR && seen(p)) cells.push_back(p);
+    }
+    return cells;
+}
+bool spawn(const coord_def &pos,int kind,int end,bool extra=false) {
+    // Native rats supply a single ordinary physical melee attack and no spells/brands.
+    // Flight, stationary behavior, stats and first-action scheduling are set explicitly below.
+    mgen_data mg(MONS_RAT,BEH_FRIENDLY,pos,MHITNOT,MG_FORCE_PLACE);
+    mg.extra_flags|=MF_NO_REWARD|MF_HARD_RESET;mg.summoner=&you;
+    mg.mname=kind==1?"Holo rose":kind==2?"Holo fox image":"Holo raven";
+    monster *mon=create_monster(mg,false);if(!mon) return false;
+    companion c;c.mid=mon->mid;c.kind=kind;c.expires=end;c.natural_end=end;c.extra=extra;c.next=you.elapsed_time+20;
+    if(kind==3 && five()) c.shield=6+s.inv/3;
+    s.companions.push_back(c);
+    mon->hit_points=mon->max_hit_points=kind==2?1:12+s.inv;
+    mon->speed=10;mon->speed_increment=0;
+    if(kind==3) mon->add_ench(mon_enchant(ENCH_FLIGHT,1,&you,end-you.elapsed_time+10));
+    ++s.totals.summons;return true;
+}
+int count() {
+    int n=0;for(auto &c:s.companions) {
+        const monster *mon=monster_by_mid(c.mid);if(mon && mon->alive() && c.expires>you.elapsed_time) ++n;
+    } return n;
+}
+void foxfire(monster &fox,monster &target,int raw,bool automatic) {
+    if(raw<=0 || !target.alive() || !line(fox.pos(),target.pos())) return;
+    if(!automatic && !roll_hit_from(fox,target,20+s.inv)) return;
+    hurt(target,raw/2,BEAM_FIRE,false);
+    if(target.alive()) hurt(target,raw-raw/2);
+}
+void deceive(companion &c) {
+    monster *fox=monster_by_mid(c.mid);if(!fox) return;
+    const int now=you.elapsed_time;
+    for(mid_t id:enemies(fox->pos(),4)) {
+        monster *mon=monster_by_mid(id);auto &t=s.targets[id];
+        if(t.immune>now || !mon->can_see(*fox) || (five() && s.performance_hits.count(id))) continue;
+        if(five()) {
+            std::vector<mid_t> images;
+            for(const auto &image:s.companions) {
+                const monster *other=monster_by_mid(image.mid);
+                if(other && other->alive() && grid_distance(mon->pos(),other->pos())<=4 && mon->can_see(*other)) images.push_back(image.mid);
+            }
+            if(images.empty() || images[id%images.size()]!=c.mid) continue;
+        }
+        t.immune=now+40;if(five()) s.performance_hits.insert(id);
+        if(x_chance_in_y(max(20,min(85,65+2*s.inv-3*mon->get_experience_level())),100)) {
+            t.raven_hits.clear();t.raven_hits[c.mid]=now+30;
+            mon->foe=fox->mindex();mon->target=fox->pos();mon->behaviour=BEH_SEEK;
+        }
+    }
+}
+int garden_radius(int at) { return s.three_end>at?3:you.piety>=75?2:1; }
+bool garden(const coord_def &pos,int at) {
+    return s.one_end>at && s.one_ready<=at && grd(pos)==DNGN_FLOOR
+        && grid_distance(s.centre,pos)<=garden_radius(at) && line(s.centre,pos);
+}
+}
+int summon_action(monster *target)
+{
+    const int now=you.elapsed_time;
+    if(is(god_id::aki)) {
+        if(s.one_end<=now && target && you.can_see(*target) && pay(3,0)) {
+            for(auto &c:s.companions) dismiss(c);
+            s.centre=target->pos();
+            while(grid_distance(you.pos(),s.centre)>4) {
+                const coord_def delta=s.centre-you.pos();s.centre-=coord_def((delta.x>0)-(delta.x<0),(delta.y>0)-(delta.y<0));
