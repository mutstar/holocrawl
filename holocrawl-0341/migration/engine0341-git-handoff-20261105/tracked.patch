+            env.properties[LAYOUT_TYPE_KEY] = "holocrawl_street01";
+            return true;
+        }
+    } catch (const std::exception &e) {
+        die("Invalid HoloCrawl street export: %s", e.what());
+    }
+
     if (player_in_branch(BRANCH_TEMPLE))
         _setup_temple_altars(you.props);
 
