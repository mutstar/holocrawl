     env.branch_uniq_map_tags = branch_uniq_map_tags[you.where_are_you];
     dgn_reset_level(enable_random_maps);
 
+    // The isolated street prototype reuses the approved procedural layout.
+    // No ordinary vault, creature, item, or trap allocator runs on this floor.
+    try {
+        if (holo34::build_street_floor()) {
+            _dgn_set_floor_colours();
