diff --git a/crawl-ref/source/stairs.cc b/crawl-ref/source/stairs.cc
index 8f75ef7..abf4442 100644
--- a/crawl-ref/source/stairs.cc
+++ b/crawl-ref/source/stairs.cc
@@ -1,4 +1,6 @@
 #include "AppHdr.h"
+#include "holo34-street.h"
+#include "holo34-city.h"
 
 #include "stairs.h"
 
@@ -1145,6 +1147,14 @@ void floor_transition(dungeon_feature_type how,
 void take_stairs(dungeon_feature_type force_stair, bool going_up,
                  bool force_known_shaft, bool update_travel_cache)
 {
+    if (holo34::city_floor_enabled() && you.depth == 14 && !going_up) {
+        mpr("HoloCrawl city prototype ends at floor 14. Use Ctrl-S to save.");
+        return;
+    }
+    if (holo34::is_street_floor()) {
+        mpr("Street prototype: floor travel will be connected next. Use Ctrl-S to save.");
+        return;
+    }
     const dungeon_feature_type old_feat = orig_terrain(you.pos());
     dungeon_feature_type how = force_stair ? force_stair : old_feat;
 
diff --git a/crawl-ref/source/tags.cc b/crawl-ref/source/tags.cc
index 4aff141..8382926 100644
--- a/crawl-ref/source/tags.cc
+++ b/crawl-ref/source/tags.cc
@@ -1241,6 +1241,9 @@ static void _ensure_exit(branch_type br)
 
 static void _add_missing_branches()
 {
+    // Branch entrances are intentionally deferred in the isolated city prototype.
+    if (env.properties.exists("holocrawl_city77"))
+        return;
     if (crawl_state.game_is_descent())
         return;
 
