@@ -82,11 +85,35 @@ static int crawl_script_args(lua_State *ls)
     return clua_stringtable(ls, crawl_state.script_args);
 }
 
+static int crawl_holo_street_test(lua_State *ls)
+{
+    try {
+        const auto result = holo34::street_native_test();
+        std::puts(result.c_str());
+        lua_pushstring(ls,result.c_str());
+        return 1;
+    } catch (const std::exception &e) {
+        return luaL_error(ls,"Native street test: %s",e.what());
+    }
+}
+static int crawl_holo_city_test(lua_State *ls)
+{
+    try {
+        const auto report = holo34::city_native_test(luaL_checkstring(ls, 1));
+        std::puts(report.c_str());
+        lua_pushstring(ls, report.c_str());
+        return 1;
+    } catch (const std::exception &error) {
+        return luaL_error(ls, "Native city test: %s", error.what());
+    }
+}
 static const struct luaL_Reg crawl_test_lib[] =
 {
     { "begin_test", crawl_begin_test },
     { "test_success", crawl_test_success },
     { "script_args", crawl_script_args },
+    { "holo_street_test", crawl_holo_street_test },
+    { "holo_city_test", crawl_holo_city_test },
     { nullptr, nullptr }
 };
 
