# Keep patches and shell scripts usable when checking out on Windows.
*.patch text eol=lf
*.sh text eol=lf

*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.webp binary

# Generated previews, audit records and engine overlays have byte-level hashes.
# Preserve mixed source line endings on every platform; retain normal text diffs.
/holocrawl-0341/preview/** -text
/holocrawl-0341/analysis/** -text
/holocrawl-0341/migration/** -text
