# The engine is an independent repository. Preserve our changes as the
# reviewed patch + overlay in holocrawl-0341/migration, not an accidental gitlink.
/holocrawl-0341/engine/upstream/

# Rebuildable game binaries, generated caches and machine-specific saves.
# Browser previews do not require this directory.
/holocrawl-0341/runtime/

