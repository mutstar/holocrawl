+void koyori_reaction(const coord_def &p,int pair) {
+#ifdef USE_TILE_LOCAL
+    if(holo_benchmark_active() || !you.see_cell(p))return;
+    const char *dir=crawl_state.test?getenv("HOLOCRAWL_KOYORI_REACTION_REVIEW"):nullptr;
+    if(crawl_state.test && !dir)return;
+    const auto before=crawl_state.test?fox_signature():std::string();
+    static int sequence=0;const int seq=++sequence;
+    flashes.clear();const int radius=pair==5?0:1;
+    for(int x=-radius;x<=radius;++x)for(int y=-radius;y<=radius;++y){
+        const auto cell=p+coord_def(x,y);
+        if(in_bounds(cell) && you.see_cell(cell) && holo_batch::line(p,cell))flashes.push_back(cell);
+    }
+    flash_kind=pair==3?effect::fire:pair==5?effect::frost:effect::slime;
+    for(int f=0;f<2;++f){
+        flash_frame=f;const auto saved=rng::generators_to_vector();redraw_fox_actors();rng::load_generators(saved);
+        if(dir)capture(std::string(dir)+"/koyori-reaction-pair"+std::to_string(pair)+"-"+std::to_string(seq)+"-frame"+std::to_string(f)+".png",false);
+        else scaled_delay(100);
+    }
+    clear();const auto saved=rng::generators_to_vector();redraw_fox_actors();rng::load_generators(saved);
+    if(crawl_state.test && before!=fox_signature())throw std::runtime_error("Koyori reaction visual changed gameplay/RNG");
 #endif
 }
 
