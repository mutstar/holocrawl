+void hawk_attack(const monster &hawk,const coord_def &target,bool hit) {
+#ifdef USE_TILE_LOCAL
+    const char *shots=crawl_state.test?getenv("HOLOCRAWL_LUI_ATTACK_REVIEW"):nullptr;
+    if(!hawk.friendly() || appearance(hawk)!=sprite::raven || holo_benchmark_active()
+        || (crawl_state.test && !shots) || !you.can_see(hawk) || !you.see_cell(target))return;
+    static int sequence=0;
+    const std::string stem=shots?std::string(shots)+"/lui-attack-"+std::to_string(++sequence):"";
+    const auto before=shots?fox_signature():std::string();
+    const auto from=hawk.pos();
+    if(shots)capture(stem+"-ready.png");
+    hawk_strike_from=from;
+    for(int f=0;f<3;++f) {
+        hawk_striking=f<2;
+        const auto rng_state=rng::generators_to_vector();
+        tiles.clear_overlays();redraw_fox_actors();rng::load_generators(rng_state);
+        if(hawk_striking)tiles.add_overlay(from,target.x<from.x?TILE_HOLO_LUI_ATTACK_LEFT:TILE_HOLO_LUI_ATTACK);
+        if(f==1 && hit)tiles.add_overlay(target,effect_tile(effect::impact,0));
+        if(shots)capture(stem+"-frame"+std::to_string(f)+".png",false);
+        else {update_screen();scaled_delay(f==0?80:f==1?95:45);}
+    }
+    hawk_striking=false;tiles.clear_overlays();
+    if(shots) {
+        std::ofstream meta(stem+".json");meta<<"{\"hit\":"<<(hit?"true":"false")<<",\"from\":["<<from.x<<','<<from.y<<"],\"target\":["<<target.x<<','<<target.y<<"]}";
+        if(before!=fox_signature()) {
+            std::ofstream(stem+"-before.txt")<<before;
+            std::ofstream(stem+"-after.txt")<<fox_signature();
+            throw std::runtime_error("Hawk attack animation changed gameplay/RNG");
+        }
+    }
+#else
+    (void)hawk;(void)target;(void)hit;
 #endif
 }
