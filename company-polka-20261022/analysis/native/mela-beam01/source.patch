+void DungeonCellBuffer::add_mela_beam_tile(int tileidx,int x,int y,int distance)
+{
+    const auto &inf=tile_feat_info(tileidx);
+    const auto *texture=static_cast<const TilesTexture *>(m_buf_holo_ground_vfx.current_texture());
+    float sx=x-(distance-1),sy=y,ex,ey,tx,ty,ux,uy;
+    if(!texture->get_coords(tileidx,(inf.width-TILE_X)/2,inf.height-TILE_Y,
+        sx,sy,ex,ey,tx,ty,ux,uy,true,-1,-1,32.0f,32.0f))return;
+    // Slice one shared160px stream at world-cell boundaries. Atlas trimming
+    // is included in sx/ex; no separate miniature flames or stretched gaps.
+    const float left=std::max(sx,float(x)),right=std::min(ex,float(x+1));
+    const float top=std::max(sy,float(y)),bottom=std::min(ey,float(y+1));
+    if(left>=right || top>=bottom)return;
+    GLWPrim cell(left,top,right,bottom);
+    cell.set_tex(tx+(ux-tx)*(left-sx)/(ex-sx),ty+(uy-ty)*(top-sy)/(ey-sy),
+        tx+(ux-tx)*(right-sx)/(ex-sx),ty+(uy-ty)*(bottom-sy)/(ey-sy));
+    m_buf_holo_ground_vfx.add_primitive(cell);
 }
 
