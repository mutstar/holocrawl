 int effect_tile(effect kind,int frame) {
     if(kind==effect::none)return 0;
+    // Saved exhibit selection drives both the cast cue and persistent badge.
+    if(kind==effect::night_raden1) {
+        if(holo_batch::s.exhibit==0)return TILE_HOLO_FX_RADENPAINTING;
+        if(holo_batch::s.exhibit==1)return TILE_HOLO_FX_RADENSCULPTURE;
+        return TILE_HOLO_FX_NIGHT_RADEN1_0;
+    }
     // Open once on activation; keep the back wings spread for the saved buff.
     if(kind==effect::night_lui5 && frame<0 && flash_kind!=effect::night_lui5)frame=1;
